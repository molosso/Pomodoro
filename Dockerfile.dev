FROM node:20-bullseye

RUN apt-get update && apt-get install -y \
  libgtk-3-0 \
  libnss3 \
  libxss1 \
  libasound2 \
  libx11-xcb1 \
  libxcomposite1 \
  libxdamage1 \
  libxrandr2 \
  libgbm1 \
  libdrm2 \
  libatk-bridge2.0-0 \
  libatk1.0-0 \
  libcups2 \
  libpangocairo-1.0-0 \
  libxkbcommon0 \
  libxshmfence1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

CMD ["npm", "start"]
